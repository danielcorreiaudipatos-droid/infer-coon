# ============================================
# OnCreators API - Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/oncreators"

# Server
NODE_ENV=development
PORT=3333
CORS_ORIGIN=*

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (SendGrid or similar)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@oncreators.com

# AWS S3 (for content storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=oncreators-content

# Analytics
ANALYTICS_ENABLED=true

# Logging
LOG_LEVEL=debug

# Commission & Pricing
COON_COMMISSION_PERCENT=30
