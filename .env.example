# on.imob — Configurações de Ambiente (Production)

# 🔐 SECURITY
SECRET_KEY=sua_chave_secreta_super_segura_aqui_32_caracteres_minimo
DEBUG=False
ENVIRONMENT=production
PORT=8000

# 🗄️ DATABASE
DATABASE_URL=postgresql://user:password@db-server:5432/on_imob_db

# 📧 EMAIL (Recuperação de senha)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_app_gmail

# 🤖 IA (Gemini Google)
GEMINI_API_KEY=sua_api_key_do_gemini_aqui

# 💬 WhatsApp (Meta API)
WHATSAPP_BUSINESS_ID=seu_business_account_id
WHATSAPP_ACCESS_TOKEN=seu_access_token_meta
WHATSAPP_VERIFY_TOKEN=seu_verify_token_unico_e_seguro

# 💳 Stripe (Pagamento com Cartão)
STRIPE_PUBLIC_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx

# 💰 Assas (PIX + Boleto + Split)
ASSAS_API_KEY=apy_xxxxx
ASSAS_ENVIRONMENT=production

# 🏦 OPEN BANKING — Itaú
ITAU_CLIENT_ID=seu_client_id_itau
ITAU_CLIENT_SECRET=seu_client_secret_itau

# 🏦 OPEN BANKING — Bradesco
BRADESCO_CLIENT_ID=seu_client_id_bradesco
BRADESCO_CLIENT_SECRET=seu_client_secret_bradesco

# 🏦 OPEN BANKING — Santander
SANTANDER_CLIENT_ID=seu_client_id_santander
SANTANDER_CLIENT_SECRET=seu_client_secret_santander

# 📍 INTEGRAÇÕES — VivaReal
VIVAREAL_TOKEN=seu_bearer_token_vivareal

# 📍 INTEGRAÇÕES — ZapImóveis
ZAPIMOVELS_TOKEN=seu_api_token_zapimovels

# 🎯 DOMÍNIO
DOMAIN=on-imob.com
API_URL=https://api.on-imob.com
FRONTEND_URL=https://on-imob.com

# 📊 CORS
ALLOWED_ORIGINS=https://on-imob.com,https://www.on-imob.com

# ⏲️ SESSION
SESSION_TIMEOUT_HOURS=24
JWT_EXPIRATION_DAYS=30
