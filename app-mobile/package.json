{
  "name": "onimob-app",
  "version": "1.0.0",
  "description": "on.imob — Sistema de Gestão Imobiliária com IA",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:capacitor": "vite build && npx cap sync",
    "android:build": "npm run build:capacitor && npx cap open android",
    "ios:build": "npm run build:capacitor && npx cap open ios",
    "android:deploy": "cd android && ./gradlew assembleRelease && cd ..",
    "ios:deploy": "cd ios && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/storage": "^6.0.0",
    "@capacitor/toast": "^6.0.0",
    "axios": "^1.6.0",
    "chart.js": "^4.4.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "vite": "^5.0.0"
  }
}
