# OnGame Production Environment Variables
# Last updated: 2026-10-03

# ============================================
# API Configuration
# ============================================
NEXT_PUBLIC_API_URL=https://api.ongame.com
NEXT_PUBLIC_COON_API_URL=https://api.coon.com
NEXT_PUBLIC_APP_NAME=OnGame
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================
# Database (Production)
# ============================================
# AWS RDS PostgreSQL 15+
DATABASE_URL=postgresql://ongame_prod_user:${DB_PASSWORD}@ongame-prod-db.region.rds.amazonaws.com/ongame_prod

# Connection Pooling
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_CACHE_SIZE=250

# ============================================
# Stripe Payment (LIVE)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_${STRIPE_SECRET_KEY_VALUE}
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_${STRIPE_PUBLISHABLE_KEY_VALUE}
STRIPE_WEBHOOK_SECRET=whsec_${STRIPE_WEBHOOK_SECRET_VALUE}

# Stripe Configuration
NEXT_PUBLIC_STRIPE_CURRENCY=BRL
STRIPE_ACCOUNT_COUNTRY=BR
STRIPE_MINIMUM_PAYOUT=500  # R$ 5.00 in cents

# ============================================
# Authentication & Security
# ============================================
# Generate: openssl rand -base64 32
JWT_SECRET=${JWT_SECRET_VALUE}
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AES-256 Encryption
ENCRYPTION_KEY=${ENCRYPTION_KEY_VALUE}
ENCRYPTION_IV=${ENCRYPTION_IV_VALUE}

# CORS Configuration
CORS_ORIGIN=https://ongame.com,https://www.ongame.com,https://coon.com,https://www.coon.com

# ============================================
# SendGrid Email Service
# ============================================
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.${SENDGRID_API_KEY_VALUE}
SENDGRID_FROM_EMAIL=noreply@ongame.com
SENDGRID_REPLY_EMAIL=support@ongame.com
SENDGRID_FROM_NAME=OnGame

# Email Templates (SendGrid IDs)
SENDGRID_TEMPLATE_WELCOME=d-${WELCOME_TEMPLATE_ID}
SENDGRID_TEMPLATE_VERIFY_EMAIL=d-${VERIFY_EMAIL_TEMPLATE_ID}
SENDGRID_TEMPLATE_PASSWORD_RESET=d-${PASSWORD_RESET_TEMPLATE_ID}
SENDGRID_TEMPLATE_WITHDRAWAL_CONFIRMATION=d-${WITHDRAWAL_CONFIRMATION_TEMPLATE_ID}
SENDGRID_TEMPLATE_PAYMENT_SUCCESS=d-${PAYMENT_SUCCESS_TEMPLATE_ID}
SENDGRID_TEMPLATE_PAYMENT_FAILED=d-${PAYMENT_FAILED_TEMPLATE_ID}

# ============================================
# Twilio SMS Service
# ============================================
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID_VALUE}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN_VALUE}
TWILIO_PHONE_NUMBER=+5585987654321  # Your Twilio phone number

# SMS Configuration
SMS_ENABLED=true
SMS_OTP_EXPIRES_IN=600  # 10 minutes
SMS_RATE_LIMIT=1  # 1 SMS per 5 minutes per user

# ============================================
# Analytics & Monitoring
# ============================================
# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=${MIXPANEL_TOKEN_VALUE}

# Google Analytics 4
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-${GA4_MEASUREMENT_ID}

# DataDog
DATADOG_API_KEY=${DATADOG_API_KEY_VALUE}
DATADOG_SITE=datadoghq.com
DATADOG_SERVICE=ongame-api
DATADOG_ENV=production
DATADOG_TRACE_ENABLED=true

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://${SENTRY_KEY}@sentry.io/${SENTRY_PROJECT_ID}
SENTRY_ENVIRONMENT=production

# ============================================
# Game Configuration
# ============================================
# ONZAP Game
ONZAP_ENABLED=true
ONZAP_MIN_REWARD=0.10
ONZAP_MAX_REWARD=50.00
ONZAP_MULTIPLIER_MAX=10

# ONLOVE Game
ONLOVE_ENABLED=true
ONLOVE_MIN_REWARD=0.10
ONLOVE_MAX_REWARD=50.00
ONLOVE_REACTION_MULTIPLIERS=2|1|0.5|0|0

# ONMAIL Game
ONMAIL_ENABLED=true
ONMAIL_MIN_REWARD=0.50
ONMAIL_MAX_REWARD=200.00
ONMAIL_DIFFICULTY_REWARDS=0.50|1.00|2.00

# ============================================
# Cosmetics Shop
# ============================================
COSMETICS_ENABLED=true
COSMETICS_MIN_PRICE=1.99
COSMETICS_MAX_PRICE=99.99
COSMETICS_CURRENCY=BRL

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_LOGIN=5/15m
RATE_LIMIT_API=100/1m
RATE_LIMIT_GAME_START=5/60m
RATE_LIMIT_WITHDRAW=1/24h
RATE_LIMIT_COSMETICS_BUY=20/60m
RATE_LIMIT_LEADERBOARD_QUERY=1000/1m

# ============================================
# Session Configuration
# ============================================
SESSION_TIMEOUT=7200000  # 2 hours in milliseconds
SESSION_ABSOLUTE_TIMEOUT=604800000  # 7 days in milliseconds
GAME_SESSION_TIMEOUT=3600000  # 1 hour for game sessions

# ============================================
# Withdrawal Configuration
# ============================================
WITHDRAWAL_MIN_AMOUNT=500  # R$ 5.00 in cents
WITHDRAWAL_MAX_AMOUNT=10000000  # R$ 100,000 in cents
WITHDRAWAL_DAILY_LIMIT=5  # 5 withdrawals per day
WITHDRAWAL_RETRY_ATTEMPTS=3
WITHDRAWAL_PROCESSING_TIME=86400000  # 24 hours in milliseconds

# ============================================
# Feature Flags
# ============================================
FEATURE_2FA=true
FEATURE_REFERRAL=true
FEATURE_SEASONAL_EVENTS=true
FEATURE_TOURNAMENTS=true
FEATURE_SOCIAL_SHARING=true

# ============================================
# Admin Configuration
# ============================================
ADMIN_EMAIL=admin@ongame.com
SUPPORT_EMAIL=support@ongame.com
SALES_EMAIL=sales@ongame.com

# Admin Panel
ADMIN_PANEL_ENABLED=true
ADMIN_REQUIRE_2FA=true
ADMIN_SESSION_TIMEOUT=3600000  # 1 hour
ADMIN_AUDIT_LOG_ENABLED=true

# ============================================
# Backup & Disaster Recovery
# ============================================
# AWS S3 for backups
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_S3_BACKUP_BUCKET=ongame-prod-backups
AWS_S3_LOG_BUCKET=ongame-prod-logs

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/ongame
LOG_ROTATION_SIZE=10485760  # 10MB
LOG_RETENTION_DAYS=90

# ============================================
# Performance & Caching
# ============================================
# Redis Caching (if using)
REDIS_URL=redis://${REDIS_USER}:${REDIS_PASSWORD}@ongame-prod-redis.region.cache.amazonaws.com:6379
REDIS_DB=0
REDIS_CACHE_TTL=3600  # 1 hour default

# ============================================
# Security Headers
# ============================================
ENABLE_CSP=true
ENABLE_HSTS=true
ENABLE_FRAMEGUARD=true
ENABLE_NOSNIFF=true
ENABLE_XSS_FILTER=true

# ============================================
# Geographic Configuration
# ============================================
DEFAULT_CURRENCY=BRL
DEFAULT_LANGUAGE=pt-BR
ALLOWED_COUNTRIES=BR,US,PT,AR,MX
BLOCKED_COUNTRIES=

# ============================================
# Third-party Integrations
# ============================================
# Facebook Login
FACEBOOK_APP_ID=${FACEBOOK_APP_ID}
FACEBOOK_APP_SECRET=${FACEBOOK_APP_SECRET}

# Google Login
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# Apple Login
APPLE_TEAM_ID=${APPLE_TEAM_ID}
APPLE_KEY_ID=${APPLE_KEY_ID}
APPLE_PRIVATE_KEY=${APPLE_PRIVATE_KEY}

# ============================================
# Version & Deployment
# ============================================
DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_REGION=global
GIT_COMMIT=${GIT_COMMIT}
BUILD_DATE=${BUILD_DATE}
BUILD_VERSION=${BUILD_VERSION}
