# ADS Inteligente — Environment Variables

# ==================== DATABASE ====================
DATABASE_URL=postgresql://user:password@localhost:5432/ads_db

# ==================== SECURITY ====================
SECRET_KEY=sua-chave-secreta-super-segura-mude-em-producao
ALGORITHM=HS256

# ==================== GOOGLE ====================
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=seu-token-google-ads
GOOGLE_ADS_CUSTOMER_ID=seu-customer-id

# ==================== META ====================
META_APP_ID=seu-meta-app-id
META_APP_SECRET=seu-meta-app-secret
META_BUSINESS_ACCOUNT_ID=seu-business-account-id

# ==================== LINKEDIN ====================
LINKEDIN_CLIENT_ID=seu-linkedin-client-id
LINKEDIN_CLIENT_SECRET=seu-linkedin-client-secret

# ==================== TIKTOK ====================
TIKTOK_CLIENT_ID=seu-tiktok-client-id
TIKTOK_CLIENT_SECRET=seu-tiktok-client-secret

# ==================== GEMINI (IA) ====================
GEMINI_API_KEY=sua-chave-gemini

# ==================== OPEN BANKING ====================
OPEN_BANKING_CLIENT_ID=seu-open-banking-id
OPEN_BANKING_CLIENT_SECRET=seu-open-banking-secret

# ==================== STRIPE ====================
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLIC_KEY=pk_live_xxxxx

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379

# ==================== APP ====================
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ==================== CORS ====================
ALLOWED_ORIGINS=http://localhost:3000,https://ads-inteligente.com

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost:3000
