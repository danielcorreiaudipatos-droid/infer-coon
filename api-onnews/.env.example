# Database
DATABASE_URL=postgresql://user:password@localhost:5432/onnews_db

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# CEP API
CEP_API_PROVIDER=viacep
CEP_API_TIMEOUT=5000

# CNPJ API
CNPJ_API_PROVIDER=brasil_io
BRASIL_IO_API_KEY=your-api-key
CNPJ_API_TIMEOUT=10000

# Cache TTL
CEP_CACHE_TTL=2592000
CNPJ_CACHE_TTL=7776000
