// ONZAP Mobile AI Chat Database Schema
// Week 1-2 Implementation

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Users (existing, extended)
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  picture           String?
  product           String   // "onzap", "coon", "onlove"
  googleId          String?  @unique
  authMethod        String   @default("google")
  apps              String[]
  emailVerified     Boolean  @default(false)
  bounced           Boolean  @default(false)
  unsubscribed      Boolean  @default(false)
  lastLoginAt       DateTime?
  bouncedAt         DateTime?
  unsubscribedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  chatMessages      ChatMessage[]
  escalationQueues  EscalationQueue[]
  aiChatMetrics     AiChatMetrics[]
  pointsLedger      PointsLedger[]
  userLevel         UserLevel?
  achievements      UserAchievement[]
  consents          UserConsent[]
  payouts           Payout[]
  campaigns         Campaign[]
  emailLogs         EmailLog[]
  whatsappMessages  WhatsappMessage[]
  subscribers       Subscriber[]
}

// ============================================
// ONZAP Mobile: AI Chat Schema
// ============================================

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  contactId String
  message   String   @db.Text
  sender    String   // "user" | "ai"
  timestamp DateTime @default(now())

  // Indexes for fast queries
  @@index([userId, contactId])
  @@index([timestamp])

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EscalationQueue {
  id        String   @id @default(cuid())
  userId    String
  contactId String
  message   String   @db.Text
  reason    String   // "ai_low_confidence", "timeout", "user_request"
  status    String   // "pending", "assigned", "resolved"
  assignedTo String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  // Indexes
  @@index([userId])
  @@index([status])

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiChatMetrics {
  id              String   @id @default(cuid())
  userId          String
  responseTime    Int      // milliseconds, target <2000
  accuracy        Float    // 0-1, target >0.7
  escalationRate  Float    // 0-1
  timestamp       DateTime @default(now())

  // Indexes
  @@index([userId])
  @@index([timestamp])

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// ONLOVE Mobile: Gamification Schema
// ============================================

model PointsLedger {
  id            String   @id @default(cuid())
  userId        String
  points        Int      // Can be negative for deductions
  action        String   // "post", "comment", "like", "follow", "daily_login"
  referenceId   String?  // ID of post/comment/etc
  description   String?
  timestamp     DateTime @default(now())

  // Indexes for fast aggregation
  @@index([userId])
  @@index([action])
  @@index([timestamp])

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLevel {
  id            String   @id @default(cuid())
  userId        String   @unique
  level         Int      @default(1) // 1, 2, 3, etc
  totalPoints   Int      @default(0)
  nextLevelAt   Int      // Points needed for next level
  updatedAt     DateTime @updatedAt

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id              String   @id @default(cuid())
  name            String
  description     String
  icon            String   // URL to icon
  requiredPoints  Int      // Points needed to unlock
  category        String   // "milestone", "badge", "special"
  createdAt       DateTime @default(now())

  // Relations
  users           UserAchievement[]
}

model UserAchievement {
  id              String   @id @default(cuid())
  userId          String
  achievementId   String
  unlockedAt      DateTime @default(now())

  // Unique constraint
  @@unique([userId, achievementId])
  @@index([userId])

  // Relations
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement     Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
}

model Leaderboard {
  id            String   @id @default(cuid())
  userId        String
  rank          Int
  points        Int
  level         Int
  lastUpdated   DateTime @default(now())

  @@index([rank])
  @@index([points])
  @@index([lastUpdated])
}

// ============================================
// Performance Metrics (All Products)
// ============================================

model PerformanceMetrics {
  id              String   @id @default(cuid())
  appName         String   // "coon", "onzap", "onlove"
  platform        String   // "mobile_android", "mobile_ios", "web"

  startupTime     Int?     // milliseconds
  memoryUsage     Int?     // MB
  batteryDrain    Float?   // % per hour
  dataUsage       Int?     // MB per hour
  apiLatency      Int?     // milliseconds

  timestamp       DateTime @default(now())

  @@index([appName])
  @@index([platform])
  @@index([timestamp])
}

model FeatureFlag {
  id              String   @id @default(cuid())
  name            String   @unique
  enabled         Boolean  @default(false)
  description     String
  rolloutPercent  Int      @default(0) // 0-100
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// Google OAuth & Auth
// ============================================

model UserConsent {
  id                    String   @id @default(cuid())
  userId                String
  consentType           String   // 'terms', 'privacy', 'marketing', 'cookies', 'lgpd', 'ccpa'
  status                String   // 'accepted', 'rejected', 'revoked'
  acceptedAt            DateTime?
  revokedAt             DateTime?
  ipAddress             String?
  userAgent             String?
  version               String   @default("1.0")
  createdAt             DateTime  @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
}

// ============================================
// Email Service (SendGrid)
// ============================================

model EmailLog {
  id                    String   @id @default(cuid())
  to                    String
  subject               String
  body                  String?
  status                String   @default("sent") // 'sent', 'delivered', 'failed', 'bounced'
  error                 String?
  opened                Boolean  @default(false)
  openedAt              DateTime?
  clicked               Boolean  @default(false)
  clickedAt             DateTime?
  sentAt                DateTime?
  updatedAt             DateTime  @updatedAt

  clicks                EmailClick[]

  @@index([to])
  @@index([sentAt])
}

model EmailClick {
  id                    String   @id @default(cuid())
  emailLogId            String
  url                   String
  clickedAt             DateTime  @default(now())

  emailLog              EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)
}

// ============================================
// Payments (Assas)
// ============================================

model Payout {
  id                    String   @id @default(cuid())
  userId                String
  assasTransferId       String?  @unique
  amount                Decimal
  status                String   @default("pending") // 'pending', 'processing', 'completed', 'failed'
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// WhatsApp Messages (Twilio)
// ============================================

model WhatsappMessage {
  id                    String   @id @default(cuid())
  userId                String?
  twilioSid             String?  @unique
  to                    String
  body                  String
  status                String   @default("sent") // 'sent', 'delivered', 'read', 'failed'
  sentAt                DateTime?
  updatedAt             DateTime  @updatedAt

  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([to])
  @@index([sentAt])
}

// ============================================
// Campaigns (Multi-platform)
// ============================================

model Campaign {
  id                    String   @id @default(cuid())
  userId                String
  name                  String
  type                  String   // 'onzap', 'onlove', 'onmail', 'wallet'
  platform              String   // 'google', 'meta', 'tiktok', 'whatsapp', 'email'
  budget                Decimal
  spent                 Decimal  @default(0)
  status                String   @default("draft") // 'draft', 'active', 'paused', 'completed'
  startDate             DateTime?
  endDate               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Subscribers (Email Lists)
// ============================================

model Subscriber {
  id                    String   @id @default(cuid())
  userId                String
  email                 String
  name                  String?
  source                String   // 'imported', 'signup', 'form', 'api'
  status                String   @default("active") // 'active', 'unsubscribed', 'bounced'
  engagementLevel       String   @default("medium") // 'high', 'medium', 'low'
  opens                 Int      @default(0)
  clicks                Int      @default(0)
  revenue               Decimal  @default(0)
  lastEngagementAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([email])
  @@index([status])
}

// ============================================
// Games System (ONZAP, ONLOVE, ONMAIL)
// ============================================

model GameSession {
  id                String   @id @default(cuid())
  userId            String
  gameType          String   // "onzap", "onlove", "onmail"
  startTime         DateTime @default(now())
  endTime           DateTime?
  score             Int      @default(0)
  status            String   @default("playing") // "playing", "finished", "abandoned"

  // Anti-cheat
  checksumData      String?
  clientVersion     String?
  deviceId          String?
  suspiciousFlag    Boolean  @default(false)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewards           GameReward[]

  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([gameType])
  @@index([status])
}

model GameReward {
  id                    String   @id @default(cuid())
  gameSessionId         String
  userId                String
  rewardType            String   // "points", "cosmetic", "cash"
  rewardValue           Decimal
  walletTransactionId   String?
  claimed               Boolean  @default(false)

  gameSession           GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([gameSessionId])
  @@index([claimed])
}

model GameLeaderboard {
  id                String   @id @default(cuid())
  gameType          String   // "onzap", "onlove", "onmail"
  userId            String
  rank              Int      @default(0)
  score             Int      @default(0)
  gamesPlayed       Int      @default(1)
  totalRewards      Decimal  @default(0)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt         DateTime @updatedAt

  @@unique([gameType, userId])
  @@index([gameType, rank])
  @@index([gameType, score])
}
