# OnGame Mobile App Environment Variables

# API Configuration
API_URL=https://api.ongame.com
API_TIMEOUT=30000

# Stripe (Production)
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx

# Analytics
MIXPANEL_TOKEN=xxxxx
