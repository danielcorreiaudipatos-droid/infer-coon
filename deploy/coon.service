[Unit]
Description=Holding COON - Servidor de Aplicativos e Motor Estatistico (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/infer-coon
ExecStart=/var/www/infer-coon/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=3
Environment="PYTHONUNBUFFERED=1"
Environment="OFFICIAL_SITE_URL=https://www.coon.com.br"

# Limites de Seguranca de Processos
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
